{
  "name": "put-v-budushchee",
  "version": "0.1.0",
  "description": "Путь в будущее — очно-заочная платформа для подростков, наставников и курсов",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/src/index.ts",
    "db:reset": "tsx server/src/reset.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
